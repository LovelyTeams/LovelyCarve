{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LovelyCarve",
  "version": "1.2.0",
  "identifier": "app.lovelycarve",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:14200",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist",
    "features": ["desktop"]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LovelyCarve",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#f8fafc"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: asset: https://asset.localhost; media-src 'self' blob: asset: https://asset.localhost; frame-src 'self' blob:; connect-src 'self' ipc: https://ipc.localhost asset: https://asset.localhost https://api.github.com; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "license": "AGPL-3.0-only",
    "shortDescription": "a forensic carver with a soft heart",
    "longDescription": "LovelyCarve is a disk forensics tool for security researchers and CTF players. It loads disk images, browses filesystems, and inspects evidence — with a UI that does not look like 1995.",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "binaries/dokan2.dll": "dokan2.dll",
      "binaries/libcrypto-4-x64.dll": "libcrypto-4-x64.dll",
      "binaries/msvcp140.dll": "msvcp140.dll",
      "binaries/msvcp140_1.dll": "msvcp140_1.dll",
      "binaries/vcruntime140.dll": "vcruntime140.dll",
      "binaries/vcruntime140_1.dll": "vcruntime140_1.dll"
    }
  }
}
