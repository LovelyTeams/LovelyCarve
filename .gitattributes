# The vendored ort-sys build script embeds build/download/dist.txt and splits it
# on '\n'; a CRLF checkout (core.autocrlf on Windows) leaves '\r' in every hash
# and URL, so the cached ONNX Runtime binaries are never found.
src-tauri/vendor/ort-sys/** text eol=lf

*.h1z binary
*.gfs1z binary
src-tauri/vendor/qnx-reader/tests/fixtures/nfi-etfs* binary
src-tauri/vendor/qnx-reader/tests/fixtures/nfi-efs* binary
