# Copyright 2026 Lamco Development LLC — MIT OR Apache-2.0.
# The EROFS frontend of the lamfold stack. Clean-roomed from the public EROFS
# on-disk format (kernel erofs_fs.h is itself SPDX MIT); see NOTICE and
# the lamfold design spec §4.

[package]
name = "lamfold-erofs"
description = "no_std read-only EROFS reader with fs-verity checks, the lamfold frontend for EROFS images, from Lamco Development LLC"
readme = "README.md"
keywords = ["erofs", "filesystem", "no_std", "fs-verity", "composefs"]
categories = ["filesystem", "no-std", "embedded"]
version = "0.1.3"
edition.workspace = true
rust-version.workspace = true
license.workspace = true
authors.workspace = true
repository.workspace = true
homepage.workspace = true
documentation = "https://docs.rs/lamfold-erofs"
include = [
    "src/**/*.rs",
    "README.md",
    "CHANGELOG.md",
    "NOTICE",
    "LICENSE-APACHE",
    "LICENSE-MIT",
]

[features]
# Uncompressed EROFS needs no codec; the integrity story (the shepherd) is on by
# default. The compact (datalayout 3) index is always read; each compression head
# is a cargo feature so a bootloader build pulls only the codecs its media needs.
# `lz4` stays the default codec (lean bootloader); `deflate`/`zstd`/`lzma` are
# opt-in. A disabled codec surfaces a clean `Unsupported` (the substrate stub).
default = ["std", "verity", "lz4"]
std = ["lamfold/std"]
verity = ["lamfold/verify"]
lz4 = ["lamfold/codec-lz4"]
deflate = ["lamfold/codec-deflate"]
zstd = ["lamfold/codec-zstd"]
lzma = ["lamfold/codec-xz"]

[dependencies]
lamfold = { workspace = true }

[package.metadata.docs.rs]
all-features = true
targets = ["x86_64-unknown-linux-gnu"]
rustdoc-args = ["--cfg", "docsrs"]

[badges]
maintenance = { status = "actively-developed" }

[dev-dependencies]
# The lz4_zeropad fixture is checked by the SHA-256 of its one file.
sha2 = { workspace = true }
